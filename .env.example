NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-local-or-project-publishable-key

# --- Colillas por correo (EmailJS + Gmail) ---
# Creá servicio Gmail + plantilla en https://www.emailjs.com
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# Opcional. Si lo dejás vacío, la app usa el nombre de la marca por defecto.
# No pongas en Netlify el mismo texto que aparece en el código (dispara secrets scan).
EMAILJS_FROM_NAME=
